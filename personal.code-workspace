  "settings": {

    /*
    EDITOR SETTINGS
    */

    /* Vertical guidelines for line wrapping. */
    "editor.rulers": [
      80,
      100,
      120,
    ],

    /* By default, wrap long lines at the viewport or 120 characters,
    whichever is narrowest. */
    "editor.wordWrap": "bounded",
    "editor.wordWrapColumn": 120,

    /* Show control and empty space characters. */
    "editor.renderControlCharacters": true,
    "editor.renderWhitespace": "all",

    /* Enforce 2 spaces for indentation by default. */
    "editor.detectIndentation": false,
    "editor.insertSpaces": true,
    "editor.tabSize": 2,

    /* Disable auto-formatting by default. */
    "editor.formatOnPaste": false,
    "editor.formatOnSave": false,
    "editor.formatOnType": false,

    /* Disable auto-fixes by default. */
    "editor.codeActionsOnSave": {
      "source.fixAll": "never"
    },

    /*
    EDITOR SETTINGS: LANGUAGE-SPECIFIC OVERRIDES
    */

    /* Wrap documentation at 72 characters. */
    "[asciidoc]": {
      "editor.wordWrap": "bounded",
      "editor.wordWrapColumn": 72,
    },
    "[markdown]": {
      "editor.wordWrap": "bounded",
      "editor.wordWrapColumn": 72,
    },

    /*
    LANGUAGE-SPECIFIC SETTINGS: ECMASCRIPT
    */

    /* Disable the built-in auto-formatting and validation for
    JavaScript/TypeScript. JS/TS repositories are required to re-enable
    this and configure on a case-by-case basis/. */
    "js/ts.format.indentSwitchCase": false,
    "js/ts.validate.enabled": false,

    /* Disable VS Code's built-in semantic checking of JS/TS files. JS/TS
    code repositories should use `jsconfig.json` or `tsconfig.json` to
    configure this, instead. */
    "js/ts.implicitProjectConfig.checkJs": false,

    /* Preference for quotes format in JS/TS code. */
    "js/ts.preferences.quoteStyle": "single",

    /*
    GIT/SCM SETTINGS
    */

    /* Remove archived repositories (🔒) from VS Code's built-in Git GUI – you
    can't push to these anyway. This setting requires absolute paths. */
    "git.ignoredRepositories": [
      "/home/kieran/dev/kieranpotts/workspace/repos/devboxes",
      "/home/kieran/dev/kieranpotts/workspace/repos/eslint-config",
      "/home/kieran/dev/kieranpotts/workspace/repos/makebook",
      "/home/kieran/dev/kieranpotts/workspace/repos/prototypes",
      "/home/kieran/dev/kieranpotts/workspace/repos/rfcs",
      "/home/kieran/dev/kieranpotts/workspace/repos/sh",
    ],

    /* Don't automatically detect submodules. */
    "git.detectSubmodules": false,
    "git.detectSubmodulesLimit": -1,

    /* Ignore changes within submodules in the file view. */
    "git.ignoreSubmodules": true,

    /* Scan depth for nested Git repositories. This is required to fully
    disable submodules in the Source Control list. */
    "git.repositoryScanMaxDepth": 0,

    /* Always prompt before committing to a protected branch. */
    "git.branchProtectionPrompt": "alwaysPrompt",
    "git.branchProtection": [
      "test",
      "prod",
    ],

    /* Disable the feature that automatically saves and restores open editors
    when switching between source control branches. Having this turned on is a
    bit annoying when working with multiple repositories in a workspace. */
    "scm.workingSets.enabled": false,

    /*
    EXTENSION SETTINGS
    */

    /*
    Asciidoc
    https://marketplace.visualstudio.com/items?itemName=asciidoctor.asciidoctor-vscode
    */

    /* When previewing Asciidoc files, use VS Code's workbench color theme,
    rather than the default Asciidoc style. This ensures the colors of the
    preview are consistent with the enabled VS Code theme. */
    "asciidoc.preview.useEditorStyle": true,

    /*
    Claude Code
    https://marketplace.visualstudio.com/items?itemName=anthropic.claude-code
    */

    "claudeCode.preferredLocation": "panel",
    "claudeCode.useCtrlEnterToSend": false,

    /*
    Code Spell Checker
    https://marketplace.visualstudio.com/items?itemName=streetsidesoftware.code-spell-checker
    */

    /* Spell check in American English. */
    "cSpell.language": "en-US",

    /* File paths to NOT spell check. */
    "cSpell.ignorePaths": [
      ".git",
      ".vscode",
      "*.log"
    ],

    /* Disable spelling errors on compound words like 'errormessage' and
    'builddir'. This setting makes the cSpell spell check unreliable and so
    we must delimit words in code, eg 'errorMessage` or `build_dir`. */
    "cSpell.allowCompoundWords": false,

    /* Custom dictionary. */
    "cSpell.customDictionaries": {
      "personalDictionary": {
        "name": "Personal Dictionary (en-US)",
        "path": "${workspaceFolder:dictionary}/src/en-US.txt",
        "scope": "workspace",
        "addWords": true
      }
    },

    /* Spellings to always ignore. These are not real words, but are names or
    identifiers of some kind: people's names, domain names, URL slugs, etc. */
    "cSpell.ignoreWords": [
      "kieran",
      "kieranpotts",
      "potts"
    ],

    /* Spellings always considered incorrect. This is useful for common spelling
    errors. For example, "hte" should be "the". */
    "cSpell.flagWords": [
      "backend",    // ✅ back-end
      "frontend",   // ✅ front-end
      "home page",  // ✅ homepage
      "hte",        // ✅ the
      "life cycle", // ✅ lifecycle
      "mockup",     // ✅ mock-up
      "mockups",    // ✅ mock-ups
      "vscode",     // ✅ vs code
      "web app",    // ✅ webapp
      "web apps",   // ✅ webapps
      "web page",   // ✅ webpage
      "web pages",  // ✅ webpages
      "web site",   // ✅ website
      "web sites",  // ✅ websites
    ],

    /*
    Fonted
    https://marketplace.visualstudio.com/items?itemName=degreat.fonted
    */

    "fonted.font": "Maple Mono",

    /*
    GitHub Copilot
    https://marketplace.visualstudio.com/items?itemName=GitHub.copilot
    */

    /* Disable autocompletion in all file types by default,
    then opt-in for specific file types. */
    "github.copilot.enable": {
      "*": false,
      "asciidoc": true,
      "markdown": true,
      "plaintext": true,

      "enableAutoCompletions": true,
      "scminput": false,
    },

    /*
    Jest
    https://github.com/jest-community/vscode-jest
    */

    /* The Jest extension is recommended for some of my projects. Unfortunately,
    this extension has an annoying habit of opening lots of terminals when
    repositories are opened that do not have a Jest configuration. From v6 of
    the extension we can disable the extension by default, and then opt back
    in to it for only the repositories within the workspace that have a Jest
    configuration. Messy, but it works around the problem. */
    "jest.enable": false,

    /*
    ToDo Tree
    https://marketplace.visualstudio.com/items?itemName=Gruntfuggly.todo-tree
    */

    /* Look only for `TODO` notations.
    This setting works only in workspace roots. */
    "todo-tree.general.tags": [
      "TODO"
    ],

    /* Ignore TODOs in the code of Git submodules. */
    "todo-tree.filtering.ignoreGitSubmodules": true,

    /*
    Windsurf (formerly Codeium)
    https://marketplace.visualstudio.com/items?itemName=codeium.codeium
    */

    /* Enable Windsurf in AsciiDoc files (experimental). */
    "codeium.enableConfig": {
      "*": true,
      "asciidoc": true
    },

    /* Enable code lens integration. */
    "codeium.enableCodeLens": false,

  }
}
