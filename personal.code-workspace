  "settings": {

    /*
    BUILT-IN SETTINGS
    */

    /* Remove archived repositories from VS Code's built-in Git GUI – you can't
    push to these repositories anyway. This setting requires absolute paths. */
    "git.ignoredRepositories": [
      "/home/kieran/dev/kieranpotts/workspace/repos/devboxes",
      "/home/kieran/dev/kieranpotts/workspace/repos/eslint-config",
      "/home/kieran/dev/kieranpotts/workspace/repos/makebook",
      "/home/kieran/dev/kieranpotts/workspace/repos/prototypes",
      "/home/kieran/dev/kieranpotts/workspace/repos/rfcs",
      "/home/kieran/dev/kieranpotts/workspace/repos/sh",
    ],

    /* Don't automatically detect submodules. */
    "git.detectSubmodules": false,
    "git.detectSubmodulesLimit": -1,

    /* Ignore changes within submodules in the file view. */
    "git.ignoreSubmodules": true,

    /* Scan depth for nested Git repositories. This is required to fully
    disable submodules in the Source Control list. */
    "git.repositoryScanMaxDepth": 0,

    /* Always prompt before committing to a protected branch. */
    "git.branchProtectionPrompt": "alwaysPrompt",
    "git.branchProtection": [
      // "stable",
      // "release/*",
    ],

    /* Disable the feature that automatically saves and restores open editors
    when switching between source control branches. Having this turned on is a
    bit annoying when working with multiple repos in a workspace. */
    "scm.workingSets.enabled": false,

    /* Set auto-forwarding of ports to the hybrid mode - appropriate for WSL. */
    "remote.autoForwardPortsSource": "hybrid",

    /*
    EXTENSION SETTINGS
    The following settings are applicable for the extensions listed in
    the `extensions.recommendations` section above.
    */

    /*
    Claude Code
    https://marketplace.visualstudio.com/items?itemName=anthropic.claude-code
    */

    "claudeCode.preferredLocation": "panel",
    "claudeCode.useCtrlEnterToSend": true,

    /*
    Code Spell Checker
    https://marketplace.visualstudio.com/items?itemName=streetsidesoftware.code-spell-checker
    */

    /* Spell check language: American English. */
    "cSpell.language": "en-US",

    /* File paths to not spell check. */
    "cSpell.ignorePaths": [
      ".git",
      ".vscode",
      "*.log"
    ],

    /* Disable spelling errors on compound words like 'errormessage' and
    'builddir'. This setting makes the cSpell spell check unreliable and so
    we must delimit words in code, eg 'errorMessage` or `build_dir`. */
    "cSpell.allowCompoundWords": false,

    /* Custom dictionary. */
    "cSpell.customDictionaries": {
      "personalDictionary": {
        "name": "Personal Dictionary (en-US)",
        "path": "${workspaceFolder:dictionary}/src/en-US.txt",
        "scope": "workspace",
        "addWords": true
      }
    },

    /* Spellings to always ignore. These are not real words, but are names or
    identifiers of some kind: people's names, domain names, URL slugs, etc. */
    "cSpell.ignoreWords": [
      "kieran",
      "kieranpotts",
      "potts"
    ],

    /* Spellings always considered incorrect. This is useful for common spelling
    errors. For example, "hte" should be "the". */
    "cSpell.flagWords": [
      "backend", // back-end
      "frontend", // front-end
      "home page", // homepage
      "hte", // the
      "life cycle", // lifecycle
      "mockup", // mock-up
      "mockups", // mock-ups
      "vscode", // vs code
      "web app", // webapp
      "web apps", // webapps
      "web page", // webpage
      "web pages", // webpages
      "web site", // website
      "web sites", // websites
    ],

    /*
    GitHub Copilot
    https://marketplace.visualstudio.com/items?itemName=GitHub.copilot
    */
    "github.copilot.enable": {
      "*": false,
      "plaintext": true,
      "markdown": true,
      "scminput": false,
      "enableAutoCompletions": true,
      "asciidoc": true
    },

    /*
    Jest is used in some of my projects, and the extension has an annoying habit
    of opening terminals when it is enabled and workspaces are opened without a
    Jest configuration.
    https://github.com/jest-community/vscode-jest
    */

    /* Fully disable the Jest extension, if it is installed, in this workspace.
    Requires v6 of the extension. */
    "jest.enable": false,

    /*
    ToDo Tree
    https://marketplace.visualstudio.com/items?itemName=Gruntfuggly.todo-tree
    */

    /* Use only `TODO` notations. This setting works only in workspace roots. */
    "todo-tree.general.tags": [
      "TODO"
    ],

    /* Ignore TODOs in the code of Git submodules. */
    "todo-tree.filtering.ignoreGitSubmodules": true,

    /*
    Windsurf (formerly Codeium)
    https://marketplace.visualstudio.com/items?itemName=codeium.codeium
    */

    /* Enable Windsurf in AsciiDoc files (experimental). */
    "codeium.enableConfig": {
      "*": true,
      "asciidoc": true
    },

    /* Enable code lens integration. */
    "codeium.enableCodeLens": false,

  }
